; Generated base project; edit freely and keep source files in this folder.
config_version=5

[application]
config/name="Our Home - Walk and Interact"
run/main_scene="res://playroom.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.12,0.13,0.13,1)

[audio]
driver/enable_input=false
